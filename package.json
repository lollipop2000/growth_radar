{
  "name": "growth-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:sprint3-5": "node --env-file=.env scripts/verify-sprint3-5.mjs",
    "acceptance:seo-actions": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-seo-actions.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "node --env-file=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import=tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "check:system": "node --env-file=.env --conditions=react-server --import=tsx scripts/check-system.ts",
    "check:secrets": "node --env-file=.env scripts/check-client-secrets.mjs",
    "worker": "node --env-file=.env --conditions=react-server --import=tsx scripts/worker.ts",
    "probe:browser": "node --import=tsx scripts/probe-browser.ts",
    "acceptance:scanner": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-scanner.ts",
    "check:clean-db": "node --env-file=.env scripts/verify-clean-db.mjs",
    "acceptance:worker": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-worker.ts",
    "acceptance:coverage": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-coverage.ts",
    "acceptance:waf": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-waf.ts",
    "worker:yandex": "node --env-file=.env --conditions=react-server --import=tsx scripts/yandex-worker.ts",
    "probe:yandex": "node --env-file=.env --conditions=react-server --import=tsx scripts/probe-yandex.ts",
    "check:yandex": "node --env-file=.env --conditions=react-server --import=tsx scripts/check-yandex.ts",
    "acceptance:yandex": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-yandex.ts",
    "acceptance:sprint3": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-sprint3.ts",
    "check:sprint3": "node --env-file=.env scripts/verify-sprint3.mjs",
    "check:localization": "node --env-file=.env --conditions=react-server --import=tsx scripts/check-sprint3-ui.ts",
    "check:sprint3-1": "node --env-file=.env scripts/verify-sprint3-1.mjs",
    "acceptance:sprint3-1": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-sprint3-1.ts",
    "acceptance:sprint3-1-ui": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-sprint3-1-ui.ts",
    "acceptance:business-data": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-business-data.ts",
    "check:sprint3-5-1": "node --env-file=.env scripts/verify-sprint3-5-1.mjs",
    "acceptance:native-search": "node --env-file=.env --conditions=react-server --import=tsx scripts/acceptance-native-search.ts",
    "ai:diagnostics": "node --env-file=.env --conditions=react-server --import=tsx scripts/ai-diagnostics.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cheerio": "^1.1.2",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "next": "^16.0.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "type": "module"
}
